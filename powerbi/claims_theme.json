{
  "name": "Claims BI Theme",
  "dataColors": ["#2E5A88", "#D9822B", "#5B9BD5", "#70AD47", "#A5A5A5", "#7F6084", "#C0392B", "#4BACC6"],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#2E5A88",
  "good": "#2E7D32",
  "neutral": "#D9822B",
  "bad": "#C0392B",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 13, "color": "#1F2933" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#52606D" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#1F2933" }
  },
  "visualStyles": {
    "*": { "*": { "border": [{ "show": false }], "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } } }] } },
    "page": { "*": { "background": [{ "color": { "solid": { "color": "#F4F6F8" } }, "transparency": 0 }] } }
  }
}
