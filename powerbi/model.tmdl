createOrReplace

	table dim_plan

		column plan_id
			dataType: string
			summarizeBy: none
			sourceColumn: plan_id

		column plan_name
			dataType: string
			summarizeBy: none
			sourceColumn: plan_name

		column line_of_business
			dataType: string
			summarizeBy: none
			sourceColumn: line_of_business

		column monthly_premium
			dataType: decimal
			formatString: \$#,0.00
			sourceColumn: monthly_premium

		partition dim_plan = m
			mode: import
			source =
					let
						Source = Csv.Document(File.Contents("C:\Users\kunta\Documents\healthcare-claims-bi\dim_plan.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
						Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
						Typed = Table.TransformColumnTypes(Promoted, {{"plan_id", type text}, {"plan_name", type text}, {"line_of_business", type text}, {"monthly_premium", Currency.Type}}, "en-US")
					in
						Typed

	table dim_member

