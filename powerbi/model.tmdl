						Source = Csv.Document(File.Contents("C:\Users\kunta\Documents\healthcare-claims-bi\dim_member.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
						Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
						Typed = Table.TransformColumnTypes(Promoted, {{"member_id", type text}, {"gender", type text}, {"birth_year", Int64.Type}, {"age_band", type text}, {"state", type text}, {"plan_id", type text}, {"enrollment_start", type date}, {"enrollment_end", type date}, {"chronic_condition_flag", Int64.Type}}, "en-US")
					in
						Typed

